{
	"name": "server",
	"version": "1.0.0",
	"private": true,
	"main": "index.js",
	"scripts": {
		"lint": "biome check src/",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:unit": "vitest run tests/unit",
		"test:integration": "vitest run tests/integration",
		"test:watch": "vitest",
		"dev": "tsx watch --env-file=.env ./src/server.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx --env-file=.env ./src/db/seed.ts"
	},
	"license": "UNLICENSED",
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"@types/bcrypt": "^6.0.0",
		"@types/node": "^24.10.1",
		"drizzle-kit": "^0.31.7",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@fastify/cors": "^11.1.0",
		"@fastify/jwt": "^10.0.0",
		"@fastify/rate-limit": "^10.3.0",
		"bcrypt": "^6.0.0",
		"drizzle-orm": "^0.44.7",
		"fastify": "^5.6.2",
		"pg": "^8.16.3",
		"zod": "^4.1.13"
	}
}
