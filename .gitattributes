# Normaliza todos os arquivos de texto para LF no repositório e no checkout,
# em conformidade com o .editorconfig (end_of_line = lf).
* text=auto eol=lf

# Arquivos binários: não aplicar conversão de fim de linha.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
